// Prisma schema — ver docs/database-design.md para DDL completa con PostGIS.
// Nota ADR-001: `location GEOGRAPHY` + trigger sync_location + vistas v_current_*
// se crean en migraciones SQL manuales; Prisma gestiona el resto.
// Enums espejan packages/types.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicStatus {
  DRAFT
  ACTIVE
  INACTIVE
  CLOSED
  PENDING_VERIFICATION

  @@map("clinic_status")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  OUTDATED
  REJECTED

  @@map("verification_status")
}

enum PricingType {
  FIXED
  RANGE
  FROM
  CONTACT

  @@map("pricing_type")
}

enum AnimalSpecies {
  DOG
  CAT
  RABBIT
  BIRD
  REPTILE
  RODENT
  EXOTIC
  OTHER

  @@map("animal_species")
}

model Country {
  id      BigInt   @id @default(autoincrement()) @db.BigInt
  iso2    String   @unique @db.Char(2)
  name    String
  regions Region[]

  @@map("country")
}

model Region {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  countryId BigInt    @map("country_id") @db.BigInt
  code      String
  name      String
  country   Country   @relation(fields: [countryId], references: [id])
  communes  Commune[]

  @@unique([countryId, code])
  @@map("region")
}

model Commune {
  id       BigInt @id @default(autoincrement()) @db.BigInt
  regionId BigInt @map("region_id") @db.BigInt
  cut      String
  name     String
  slug     String @unique @db.Citext
  region   Region @relation(fields: [regionId], references: [id])

  @@map("commune")
}

model Clinic {
  id                 BigInt              @id @default(autoincrement()) @db.BigInt
  name               String
  slug               String              @unique @db.Citext
  description        String?
  phoneE164          String?             @map("phone_e164")
  email              String?             @db.Citext
  website            String?
  whatsappE164       String?             @map("whatsapp_e164")
  status             ClinicStatus        @default(DRAFT)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  isEmergency        Boolean             @default(false) @map("is_emergency")
  is24h              Boolean             @default(false) @map("is_24h")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  services           ClinicService[]
  exams              ClinicExam[]
  equipment          ClinicEquipment[]
  animals            ClinicAnimal[]
  photos             ClinicPhoto[]
  schedules          Schedule[]
  reports            Report[]
  events             ClinicEvent[]
  advertisements     Advertisement[]
  subscriptions      PremiumSubscription[]
  submissions        Submission[]
  qualityIssues      DataQualityIssue[]
  qualityScore       ClinicQualityScore?
  importMatchedRows  ImportBatchRow[]

  @@map("clinic")
}

model Service {
  id      BigInt          @id @default(autoincrement()) @db.BigInt
  name    String
  slug    String          @unique @db.Citext
  isActive Boolean        @default(true) @map("is_active")
  clinics ClinicService[]

  @@map("service")
}

model Exam {
  id      BigInt       @id @default(autoincrement()) @db.BigInt
  name    String
  slug    String       @unique @db.Citext
  isActive Boolean     @default(true) @map("is_active")
  clinics ClinicExam[]

  @@map("exam")
}

model Specialty {
  id   BigInt @id @default(autoincrement()) @db.BigInt
  name String
  slug String @unique @db.Citext
  isActive Boolean @default(true) @map("is_active")

  @@map("specialty")
}

model Equipment {
  id      BigInt            @id @default(autoincrement()) @db.BigInt
  name    String
  slug    String            @unique @db.Citext
  clinics ClinicEquipment[]

  @@map("equipment")
}

model ClinicEquipment {
  clinicId    BigInt    @map("clinic_id") @db.BigInt
  equipmentId BigInt    @map("equipment_id") @db.BigInt
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@id([clinicId, equipmentId])
  @@map("clinic_equipment")
}

model ClinicAnimal {
  clinicId BigInt         @map("clinic_id") @db.BigInt
  species  AnimalSpecies
  clinic   Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([clinicId, species])
  @@map("clinic_animal")
}

model ClinicService {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  clinicId   BigInt   @map("clinic_id") @db.BigInt
  serviceId  BigInt   @map("service_id") @db.BigInt
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id])
  prices     ClinicServicePrice[]

  @@unique([clinicId, serviceId])
  @@map("clinic_service")
}

model ClinicExam {
  id       BigInt   @id @default(autoincrement()) @db.BigInt
  clinicId BigInt   @map("clinic_id") @db.BigInt
  examId   BigInt   @map("exam_id") @db.BigInt
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  exam     Exam     @relation(fields: [examId], references: [id])
  prices   ClinicExamPrice[]

  @@unique([clinicId, examId])
  @@map("clinic_exam")
}

model ClinicServicePrice {
  id              BigInt    @id @default(autoincrement()) @db.BigInt
  clinicServiceId BigInt    @map("clinic_service_id") @db.BigInt
  minAmount       Int?      @map("min_amount")
  maxAmount       Int?      @map("max_amount")
  pricingType     PricingType @map("pricing_type")
  currency        String    @default("CLP") @db.Char(3)
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  source             VerificationSource?
  verificationStatus VerificationStatus  @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz
  notes              String?
  clinicService   ClinicService @relation(fields: [clinicServiceId], references: [id], onDelete: Cascade)

  @@map("clinic_service_price")
}

model ClinicExamPrice {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  clinicExamId BigInt    @map("clinic_exam_id") @db.BigInt
  minAmount    Int?      @map("min_amount")
  maxAmount    Int?      @map("max_amount")
  pricingType  PricingType @map("pricing_type")
  currency     String    @default("CLP") @db.Char(3)
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Date
  validUntil   DateTime? @map("valid_until") @db.Date
  source             VerificationSource?
  verificationStatus VerificationStatus  @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz
  notes              String?
  clinicExam   ClinicExam @relation(fields: [clinicExamId], references: [id], onDelete: Cascade)

  @@map("clinic_exam_price")
}

enum VerificationSource {
  OFFICIAL_WEBSITE
  OFFICIAL_SOCIAL_MEDIA
  PHONE
  WHATSAPP
  EMAIL
  DIRECT_COMMUNICATION
  PUBLIC_SOURCE
  ADMIN_RESEARCH
  OTHER
  COMMUNITY

  @@map("verification_source")
}

model User {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("user")
}

model VerificationLog {
  id          BigInt              @id @default(autoincrement()) @db.BigInt
  entityType  String              @map("entity_type")
  entityId    BigInt              @map("entity_id") @db.BigInt
  oldStatus   VerificationStatus? @map("old_status")
  newStatus   VerificationStatus  @map("new_status")
  changedBy   BigInt?             @map("changed_by") @db.BigInt
  source      VerificationSource? 
  method      String?
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@map("verification_log")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  userId     BigInt?  @map("user_id") @db.BigInt
  action     String
  entityType String   @map("entity_type")
  entityId   BigInt   @map("entity_id") @db.BigInt
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_log")
}

model Report {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  clinicId     BigInt?  @map("clinic_id") @db.BigInt
  reason       String
  message      String?
  reporterHash String?  @map("reporter_hash")
  status       String   @default("OPEN")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@map("report")
}

model SlugRedirect {
  oldSlug   String   @id @db.Citext @map("old_slug")
  newSlug   String   @db.Citext @map("new_slug")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("slug_redirect")
}

model ClinicPhoto {
  id                 BigInt              @id @default(autoincrement()) @db.BigInt
  clinicId           BigInt              @map("clinic_id") @db.BigInt
  url                String
  publicId           String?             @map("public_id")
  altText            String?             @map("alt_text")
  sortOrder          Int                 @default(0) @map("sort_order")
  isPrimary          Boolean             @default(false) @map("is_primary")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_photo")
}

model Schedule {
  id                 BigInt              @id @default(autoincrement()) @db.BigInt
  clinicId           BigInt              @map("clinic_id") @db.BigInt
  dayOfWeek          Int                 @map("day_of_week")
  openingTime        DateTime?           @map("opening_time") @db.Time
  closingTime        DateTime?           @map("closing_time") @db.Time
  isClosed           Boolean             @default(false) @map("is_closed")
  isOvernight        Boolean             @default(false) @map("is_overnight")
  validFrom          DateTime?           @map("valid_from") @db.Date
  validUntil         DateTime?           @map("valid_until") @db.Date
  label              String?
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz
  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("schedule")
}

model ClinicEvent {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  clinicId    BigInt?  @map("clinic_id") @db.BigInt
  type        String
  sessionHash String?  @map("session_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@map("clinic_event")
}

model Advertisement {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  clinicId     BigInt?  @map("clinic_id") @db.BigInt
  campaignName String   @map("campaign_name")
  placement    String
  startAt      DateTime @map("start_at") @db.Timestamptz
  endAt        DateTime @map("end_at") @db.Timestamptz
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("advertisement")
}

model PremiumSubscription {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  clinicId  BigInt    @map("clinic_id") @db.BigInt
  planId    String    @map("plan_id")
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("premium_subscription")
}

// Aportes ciudadanos moderados (ADR-006, migración 0009_submissions).
model Submission {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  trackingCode      String    @unique @map("tracking_code")
  type              String
  clinicId          BigInt?   @map("clinic_id") @db.BigInt
  payload           Json
  message           String?
  evidenceUrl       String?   @map("evidence_url")
  submitterName     String?   @map("submitter_name")
  submitterEmail    String?   @map("submitter_email") @db.Citext
  consentAt         DateTime? @map("consent_at") @db.Timestamptz
  submitterHash     String?   @map("submitter_hash")
  status            String    @default("PENDING")
  reviewedBy        BigInt?   @map("reviewed_by") @db.BigInt
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes       String?   @map("review_notes")
  appliedEntityType String?   @map("applied_entity_type")
  appliedEntityId   BigInt?   @map("applied_entity_id") @db.BigInt
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  clinic            Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@map("submission")
}

// Motor de Calidad de Datos (Fase 2, migración 0010_data_quality)
enum DataQualitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("data_quality_severity")
}

enum DataQualityStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("data_quality_status")
}

enum DataQualityTrigger {
  MANUAL
  SCHEDULED_CRON

  @@map("data_quality_trigger")
}

model DataQualityRun {
  id                  BigInt             @id @default(autoincrement()) @db.BigInt
  triggerType         DataQualityTrigger @default(MANUAL) @map("trigger_type")
  triggeredBy         BigInt?            @map("triggered_by") @db.BigInt
  evaluatedClinics    Int                @default(0) @map("evaluated_clinics")
  openIssuesCount     Int                @default(0) @map("open_issues_count")
  resolvedIssuesCount Int                @default(0) @map("resolved_issues_count")
  executionTimeMs     Int                @default(0) @map("execution_time_ms")
  startedAt           DateTime           @default(now()) @map("started_at") @db.Timestamptz
  finishedAt          DateTime?          @map("finished_at") @db.Timestamptz
  issues              DataQualityIssue[]

  @@map("data_quality_run")
}

model DataQualityIssue {
  id                BigInt              @id @default(autoincrement()) @db.BigInt
  clinicId          BigInt              @map("clinic_id") @db.BigInt
  runId             BigInt?             @map("run_id") @db.BigInt
  ruleCode          String              @map("rule_code")
  severity          DataQualitySeverity
  status            DataQualityStatus   @default(OPEN)
  causeDescription  String              @map("cause_description")
  recommendedAction String              @map("recommended_action")
  metadata          Json                @default("{}")
  fingerprint       String
  firstDetectedAt   DateTime            @default(now()) @map("first_detected_at") @db.Timestamptz
  lastEvaluatedAt   DateTime            @default(now()) @map("last_evaluated_at") @db.Timestamptz
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz
  resolvedBy        BigInt?             @map("resolved_by") @db.BigInt
  resolutionNotes   String?             @map("resolution_notes")
  resolutionReason  String?             @map("resolution_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  run               DataQualityRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([fingerprint, status], name: "unique_open_issue_fingerprint")
  @@map("data_quality_issue")
}

model ClinicQualityScore {
  clinicId          BigInt   @id @map("clinic_id") @db.BigInt
  score             Int
  completenessScore Int      @map("completeness_score")
  verificationScore Int      @map("verification_score")
  freshnessScore    Int      @map("freshness_score")
  activeIssuesCount Int      @default(0) @map("active_issues_count")
  factorBreakdown   Json     @default("{}") @map("factor_breakdown")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_quality_score")
}

// Pipeline de Ingesta Avanzada (Fase 3, ADR-007, migración 0011_import_pipeline)
enum ImportBatchStatus {
  PENDING_ANALYSIS
  ANALYZING
  ANALYZED
  APPLYING
  COMPLETED
  FAILED
  CANCELLED

  @@map("import_batch_status")
}

enum ImportRowStatus {
  PENDING
  VALID
  POSSIBLE_DUPLICATE
  INVALID
  APPLIED
  REJECTED
  ERROR

  @@map("import_row_status")
}

enum ImportActionType {
  INSERT
  UPDATE
  SKIP

  @@map("import_action_type")
}

model ImportBatch {
  id            BigInt            @id @default(autoincrement()) @db.BigInt
  filename      String
  uploadedBy    BigInt?           @map("uploaded_by") @db.BigInt
  status        ImportBatchStatus @default(PENDING_ANALYSIS)
  totalRows     Int               @default(0) @map("total_rows")
  validRows     Int               @default(0) @map("valid_rows")
  duplicateRows Int               @default(0) @map("duplicate_rows")
  errorRows     Int               @default(0) @map("error_rows")
  appliedRows   Int               @default(0) @map("applied_rows")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz
  rows          ImportBatchRow[]

  @@map("import_batch")
}

model ImportBatchRow {
  id              BigInt           @id @default(autoincrement()) @db.BigInt
  batchId         BigInt           @map("batch_id") @db.BigInt
  rowNumber       Int              @map("row_number")
  rawData         Json             @map("raw_data")
  parsedData      Json?            @map("parsed_data")
  status          ImportRowStatus  @default(PENDING)
  actionType      ImportActionType @default(INSERT) @map("action_type")
  matchedClinicId BigInt?          @map("matched_clinic_id") @db.BigInt
  matchReason     String?          @map("match_reason")
  matchScore      Float?           @map("match_score")
  differences     Json             @default("{}")
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  batch           ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedClinic   Clinic?          @relation(fields: [matchedClinicId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber], name: "unique_batch_row_number")
  @@map("import_batch_row")
}

