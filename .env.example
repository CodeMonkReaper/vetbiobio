# Copiar a .env (nunca versionar el real)
# Ver docs/security-privacy.md

# Postgres
DATABASE_URL=postgresql://vetbiobio:changeme@localhost:5432/vetbiobio?schema=public
POSTGRES_USER=vetbiobio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vetbiobio

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-in-prod-min-32-chars
SESSION_SECRET=change-me-in-prod-min-32-chars

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mapbox (solo clave pública en frontend)
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observabilidad / analytics (post-MVP)
SENTRY_DSN=
ANALYTICS_PROVIDER=
